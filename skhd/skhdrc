cmd - tab : ~

# Window Navigation (through display borders): lalt - {j, k, l, ö}
alt - k : is_fs=$(yabai -m query --windows --window | jq -r '.["has-fullscreen-zoom"]'); if [ "$is_fs" = true ]; then yabai -m window --focus next; else yabai -m window --focus north; fi
alt - j : is_fs=$(yabai -m query --windows --window | jq -r '.["has-fullscreen-zoom"]'); if [ "$is_fs" = true ]; then yabai -m window --focus prev; else yabai -m window --focus south; fi
alt - h : yabai -m window --focus west
alt - l : yabai -m window --focus east

# Moving windows
## Swapping
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east
## moving to spaces
alt - p : yabai -m space --focus prev
alt - n : yabai -m space --focus next
## Moving windows to spaces
shift + alt - p : yabai -m window --space prev || yabai -m window --space last && yabai -m space --focus prev || yabai -m space --focus last
shift + alt - n : yabai -m window --space next || yabai -m window --space first && yabai -m space --focus next || yabai -m space --focus first
## Rearranging layout
shift + alt - r : yabai -m space --rotate 270
shift + alt - y : yabai -m space --mirror y-axis
shift + alt - x : yabai -m space --mirror x-axis

# Resize windows
shift + ctrl + alt - h : \
    is_float=$(yabai -m query --windows --window | jq '.["is-floating"]'); \
    if [ "$is_float" = true ]; then \
        yabai -m window --resize right:-50:0; \
    else \
        yabai -m window --resize left:-50:0; yabai -m window --resize right:-50:0; \
    fi
shift + ctrl + alt - j : yabai -m window --resize bottom:0:50; yabai -m window --resize top:0:50
shift + ctrl + alt - k : yabai -m window --resize top:0:-50; yabai -m window --resize bottom:0:-50
shift + ctrl + alt - l :
    is_float=$(yabai -m query --windows --window | jq '.["is-floating"]'); \
    if [ "$is_float" = true ]; then \
        yabai -m window --resize left:50:0; \
    else \
        yabai -m window --resize right:50:0; yabai -m window --resize left:50:0; \
    fi

# Float / Unfloat window
shift + alt - space : \
    yabai -m window --toggle float; \
    yabai -m window --toggle border

# Space Navigation (four spaces per display): lalt - {1, 2, 3, 4}
alt - 1 : num_spaces="$(yabai -m query --spaces | jq length)"; DISPLAY="$(yabai -m query --displays --display | jq '.index')"; yabai -m space --focus $((1+$num_spaces*($DISPLAY - 1)))
alt - 2 : num_spaces="$(yabai -m query --spaces | jq length)"; DISPLAY="$(yabai -m query --displays --display | jq '.index')"; yabai -m space --focus $((2+$num_spaces*($DISPLAY - 1)))
alt - 3 : num_spaces="$(yabai -m query --spaces | jq length)"; DISPLAY="$(yabai -m query --displays --display | jq '.index')"; yabai -m space --focus $((3+$num_spaces*($DISPLAY - 1)))
alt - 4 : num_spaces="$(yabai -m query --spaces | jq length)"; DISPLAY="$(yabai -m query --displays --display | jq '.index')"; yabai -m space --focus $((4+$num_spaces*($DISPLAY - 1)))
alt - 5 : num_spaces="$(yabai -m query --spaces | jq length)"; DISPLAY="$(yabai -m query --displays --display | jq '.index')"; yabai -m space --focus $((5+$num_spaces*($DISPLAY - 1)))
ctrl - 1: ~
ctrl - 2: ~
ctrl - 3: ~
shift + alt - 1 : yabai -m display --focus 1
shift + alt - 2 : yabai -m display --focus 2

# shift + alt - d : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus
# shift + alt - d : for i in $(yabai -m query --windows --space | jq -r '.[].id'); do yabai -m window $i --toggle zoom-fullscreen; done;
shift + alt - d : var=$(yabai -m query --windows --space | jq '[ .[]."has-fullscreen-zoom" ] | unique | length != 1'); \
                    if [ "$var" = "true" ]; then \
                         elements=$(yabai -m query --windows --space | jq -r '[ .[] | select(."has-fullscreen-zoom" == false) | . ] | .[].id'); \
                         for i in "${elements[@]}"; do \
                             yabai -m window $i --toggle zoom-fullscreen; \
                         done; \
                    else \
                        for i in $(yabai -m query --windows --space | jq -r '.[].id'); do yabai -m window $i --toggle zoom-fullscreen; done; \
                    fi;
shift + alt - i : yabai -m window --toggle zoom-parent
shift + alt - e : yabai -m space --balance

ctrl + alt + cmd - r : yabai --restart-service

cmd + shift - a : yabai -m window --move rel:-50:0
cmd + shift - d : yabai -m window --move rel:50:0
cmd + shift - w : yabai -m window --move rel:0:-50
cmd + shift - s : yabai -m window --move rel:0:50
